# real secrets using 1Password. Never deploy literal placeholders.
SECRET_KEY=REQUIRED_UNIQUE_SECRET_FROM_1PASSWORD
JWT_PUBLIC_KEY=REQUIRED_MATCHED_PUBLIC_JWK
JWT_PRIVATE_KEY=REQUIRED_PRIVATE_JWK_FROM_1PASSWORD
POSTGRES_USER=fitness_wger
POSTGRES_PASSWORD=REQUIRED_DATABASE_PASSWORD_FROM_1PASSWORD
POSTGRES_DB=fitness_wger
PS_DATABASE_URI=postgres://fitness_wger:REQUIRED_URLENCODED_DATABASE_PASSWORD@db:5432/fitness_wger
PS_STORAGE_PG_URI=postgres://powersync_storage:REQUIRED_STORAGE_PASSWORD@db:5432/fitness_wger
PS_PORT=8080
POWERSYNC_URL_PATH=ps
SITE_URL=https://REQUIRED_VERIFIED_TAILNET_HOST
CSRF_TRUSTED_ORIGINS=https://REQUIRED_VERIFIED_TAILNET_HOST
MEDIA_URL=https://REQUIRED_VERIFIED_TAILNET_HOST/media/
STATIC_URL=https://REQUIRED_VERIFIED_TAILNET_HOST/static/
X_FORWARDED_PROTO_HEADER_SET=True
USE_X_FORWARDED_HOST=True
TIME_ZONE=Australia/Sydney
TZ=Australia/Sydney
ALLOW_REGISTRATION=False
ALLOW_GUEST_USERS=False
ALLOW_UPLOAD_VIDEOS=False
ENABLE_EMAIL=False
USE_RECAPTCHA=False
DJANGO_DEBUG=False
WGER_USE_GUNICORN=True
WGER_PORT=8000
GUNICORN_CMD_ARGS=--workers 1 --threads 2 --worker-class gthread --timeout 240
DJANGO_PERFORM_MIGRATIONS=True
DJANGO_COLLECTSTATIC_ON_STARTUP=True
DJANGO_CLEAR_STATIC_FIRST=False
USE_CELERY=True
CELERY_BROKER=redis://cache:6379/2
CELERY_BACKEND=redis://cache:6379/2
CELERY_WORKER_CONCURRENCY=1
DJANGO_CACHE_BACKEND=django_redis.cache.RedisCache
DJANGO_CACHE_LOCATION=redis://cache:6379/1
DJANGO_CACHE_TIMEOUT=1296000
DJANGO_CACHE_CLIENT_CLASS=django_redis.client.DefaultClient
WGER_INSTANCE=https://wger.de
SYNC_EXERCISES_ON_STARTUP=False
DOWNLOAD_EXERCISE_IMAGES_ON_STARTUP=False
SYNC_EXERCISES_CELERY=False
SYNC_EXERCISE_IMAGES_CELERY=False
SYNC_EXERCISE_VIDEOS_CELERY=False
SYNC_INGREDIENTS_CELERY=False
CACHE_API_EXERCISES_CELERY=False
DOWNLOAD_INGREDIENTS_FROM=None
AXES_ENABLED=True
AXES_FAILURE_LIMIT=10
AXES_COOLOFF_TIME=30
NUMBER_OF_PROXIES=2
EXPOSE_PROMETHEUS_METRICS=False
